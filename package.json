{
  "name": "lhc-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Scientifically grounded, interactive 3D LHC simulator (Three.js / WebGPU) — Phase 2: real data & real physics",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:events": "vite-node scripts/generate-events.ts",
    "postinstall": "node scripts/copy-decoders.mjs",
    "fetch:cern": "vite-node scripts/fetch-cern-dataset.ts"
  },
  "dependencies": {
    "jsroot": "^7.11.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.2"
  }
}
